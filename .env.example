# ─── Required ────────────────────────────────────────────────────────────────

# The Odds API (primary) — free tier gives ~500 requests/month
# Get your key at: https://the-odds-api.com
THE_ODDS_API_KEY=your_the_odds_api_key_here

# ─── Optional ────────────────────────────────────────────────────────────────

# Odds-API.io (secondary/fallback odds source)
# Get your key at: https://odds-api.io
ODDS_API_KEY=your_odds_api_key_here

# SQLite database path (default: ./data/fund.db)
# DATABASE_PATH=./data/fund.db

# Output directory for generated reports (default: ./reports)
# REPORT_OUTPUT_DIR=./reports
